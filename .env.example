# Scriptum v2.5 — Frontend Environment Variables
# Copiar para .env.local e preencher com valores reais

# URL do backend (local ou produção)
VITE_API_BASE_URL=http://localhost:5001

# As chaves de API (Gemini, TMDB, OpenSubtitles) pertencem ao BACKEND
# Configurar em /Users/f.nuno/projetos/subtitle-translator/.env:
#   GEMINI_API_KEY=<gerar em https://aistudio.google.com/apikey>
#   TMDB_API_KEY=<gerar em https://www.themoviedb.org/settings/api>
#   OPENSUBTITLES_API_KEY=<gerar em https://www.opensubtitles.com/consumers>
#   OPENSUBTITLES_USER_AGENT=Scriptum v2.5
